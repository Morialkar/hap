{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    "fs:allow-open",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-seek",
    "fs:allow-read",
    "fs:allow-fstat",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$RESOURCE/fixtures/*"
        }
      ]
    }
  ]
}